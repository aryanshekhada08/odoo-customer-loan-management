<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_installment_reminder" model="mail.template">
        <field name="name">Loan Installment Reminder</field>
        <field name="model_id" ref="customer_loan.model_loan_installment"/>
        <field name="subject">Reminder: loan installment due on {{ object.due_date }}</field>
        <field name="email_from">{{ object.loan_id.user_id.email_formatted or object.env.company.email_formatted or user.email_formatted }}</field>
        <field name="partner_to">{{ object.loan_id.customer_id.id }}</field>
        <field name="use_default_to" eval="False"/>
        <field name="auto_delete" eval="False"/>
        <field name="body_html" type="html">
            <div>
                <p>Hello <t t-out="object.loan_id.customer_id.name or 'Customer'"/>,</p>
                <p>This is a reminder that your loan installment is due soon.</p>
                <p>
                    <strong>Loan:</strong>
                    <t t-out="object.loan_id.loan_no or ''"/>
                    <br/>
                    <strong>Installment:</strong>
                    <t t-out="object.sequence or ''"/>
                    <br/>
                    <strong>Due Date:</strong>
                    <t t-out="object.due_date or ''"/>
                    <br/>
                    <strong>Due Amount:</strong>
                    <t t-out="object.due_amount or object.amount or 0.0"/>
                </p>
            </div>
        </field>
    </record>
</odoo>
