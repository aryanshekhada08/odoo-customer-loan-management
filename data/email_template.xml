<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="email_template_installment_reminder" model="mail.template">
        <field name="name">
                Installment Reminder Email
            </field>
        <field name="model_id" ref="customer_loan.model_loan_installment"/>
        <field name="subject">
                Installment Reminder
            </field>
        <field name="email_to">
                ${object.loan_id.customer_id.email}
            </field>
        <field name="body_html" type="html">
            <div>
                <p>Hello Customer</p>
                <p>Your installment is due soon.</p>
            </div>
        </field>
    </record>
</odoo>
