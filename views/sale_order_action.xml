<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit existing Sales Order action -->
    <record id="sale.action_orders" model="ir.actions.act_window">
        <!-- Default filter -->
        <field name="context">
            {'search_default_sales': 1, 'search_default_my_agent_orders': 1}
        </field>
    </record>

    <record id="sale.action_quotations" model="ir.actions.act_window">
        <field name="context">
            {'search_default_my_agent_orders': 1}
        </field>
    </record>

    <record id="sale.action_quotations_with_onboarding" model="ir.actions.act_window">
        <field name="context">
            {'search_default_my_agent_orders': 1}
        </field>
    </record>
</odoo>
