<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="loan_user_rule" model="ir.rule">
        <field name="name">Loan User: own loans</field>
        <field name="model_id" ref="model_loan_management"/>
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('customer_loan.group_loan_user'))]"/>
    </record>

    <record id="loan_admin_rule" model="ir.rule">
        <field name="name">Loan Admin: all loans</field>
        <field name="model_id" ref="model_loan_management"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('customer_loan.group_loan_admin'))]"/>
    </record>

    <record id="loan_installment_user_rule" model="ir.rule">
        <field name="name">Loan User: own loan installments</field>
        <field name="model_id" ref="model_loan_installment"/>
        <field name="domain_force">[('loan_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('customer_loan.group_loan_user'))]"/>
    </record>

    <record id="loan_installment_admin_rule" model="ir.rule">
        <field name="name">Loan Admin: all installments</field>
        <field name="model_id" ref="model_loan_installment"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('customer_loan.group_loan_admin'))]"/>
    </record>
</odoo>
